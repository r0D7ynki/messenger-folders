{
  "manifest_version": 3,
  "name": "Messenger Folders",
  "version": "1.0.0",
  "description": "Organizuj konwersacje w Messengerze za pomocą folderów i kategorii.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.messenger.com/*", "*://*.facebook.com/messages/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Messenger Folders",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.messenger.com/*", "*://*.facebook.com/messages/*"],
      "js": ["src/storage.js", "src/detector.js", "src/ui.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
